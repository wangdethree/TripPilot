# All settings use the TRIPPILOT_ prefix. Never commit real secrets.
TRIPPILOT_APP_ENV=local
TRIPPILOT_LOG_LEVEL=INFO
TRIPPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRIPPILOT_TOKEN_PEPPER=replace-with-a-long-random-secret

# fake keeps local development deterministic and free.
TRIPPILOT_MODEL_PROVIDER=fake
TRIPPILOT_OPENAI_API_KEY=
TRIPPILOT_OPENAI_BASE_URL=
TRIPPILOT_EXTRACTION_MODEL=gpt-5.6-luna
TRIPPILOT_PLANNING_MODEL=gpt-5.6-terra

# fake uses versioned fixtures. real enables Open-Meteo weather and AMap places.
TRIPPILOT_TOOL_PROVIDER=fake
TRIPPILOT_AMAP_API_KEY=
TRIPPILOT_TOOL_TIMEOUT_SECONDS=8
TRIPPILOT_TOOL_MAX_RETRIES=2

# Used by migrations and the production worker implementation.
TRIPPILOT_DATABASE_URL=postgresql+psycopg://trippilot:trippilot@localhost:5432/trippilot
